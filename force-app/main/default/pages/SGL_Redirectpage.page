<apex:page controller="SGL_RedirectController" action="{!init}">
  <apex:form>
    <apex:outputPanel id="loadingPanel">
      <apex:outputText value="Generando token y redirigiendo..." />
    </apex:outputPanel>
  </apex:form>

  <script>
    var token = "{!JSENCODE(jwtToken)}";
    var targetUrl = "{!JSENCODE(targetUrl)}";
    var returnUrl = "{!JSENCODE(returnUrl)}";
    var back = window.location.href;
    if (returnUrl) {
      try {
        if (
          new URL(returnUrl, window.location.origin).origin ===
          window.location.origin
        ) {
          back = returnUrl;
        }
      } catch (e) {}
    }
    if (token && targetUrl) {
      var redirectUrl =
        targetUrl +
        "?token=" +
        encodeURIComponent(token) +
        "&url=" +
        encodeURIComponent(back);
      window.location.replace(redirectUrl);
    }
  </script>
</apex:page>
