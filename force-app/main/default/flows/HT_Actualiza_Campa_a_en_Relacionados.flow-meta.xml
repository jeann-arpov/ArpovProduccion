<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Este flujo toma el valor de la ultima campaña relacionada a Oportunidad, y Compra HT y setea la ultima campaña en el campo de cada objeto (Actualiza el campo campaña de los registros). No corre si la HT no tiene Oportunidad (PPH / Compra SF), para no consultar las 200k+ HT con oportunidad nula.</description>
    <environments>Default</environments>
    <interviewLabel>[HT] Actualiza Campaña en Relacionados {!$Flow.CurrentDateTime}</interviewLabel>
    <label>[HT] Actualiza Campaña en Relacionados</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Obtener_ltima_HT</name>
        <label>Obtener última HT</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Actualiza_Campa_a_en_Oportunidad_Relacionada</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Oportunidad__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Oportunidad__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Hectareas_Tecnologicas__c</object>
        <queriedFields>Campania__c</queriedFields>
        <sortField>LastModifiedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Actualiza</name>
        <label>Actualiza Campaña en Compra HT Relacionada</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Oportunidad__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Oportunidad__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Campa_a__c</field>
            <value>
                <elementReference>Obtener_ltima_HT.Campania__c</elementReference>
            </value>
        </inputAssignments>
        <object>Compra_HT__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Actualiza_Campa_a_en_Oportunidad_Relacionada</name>
        <label>Actualiza Campaña en Oportunidad Relacionada</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Actualiza</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Oportunidad__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Campa_a_Agricola__c</field>
            <value>
                <elementReference>Obtener_ltima_HT.Campania__c</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Obtener_ltima_HT</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Campania__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Oportunidad__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Hectareas_Tecnologicas__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
